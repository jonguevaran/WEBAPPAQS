      },
      {
        "tipo": "texto",
        "valor": "Entramos al global SPAGESTA ^SPAUSROPER y añadimos también su usuario.",
        "img": {
          "url": "blob:https://aquaservice.atlassian.net/92cfceca-fada-4a8a-b81c-f869fe65ab6e#media-blob-url=true&id=40c08edc-b7f8-4023-aaf9-99a41a55f04e&clientId=717661f0-ab27-4d5c-b1a7-f5cbbe757146&contextId=contentId-8390378&collection=contentId-8390378",
