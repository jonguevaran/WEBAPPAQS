      },
      {
        "tipo": "texto",
        "valor": "Se abre la ventana de detalle de la promoción con el botón para eliminar.",
        "img": {
          "url": "blob:https://aquaservice.atlassian.net/92cfceca-fada-4a8a-b81c-f869fe65ab6e#media-blob-url=true&id=cfa9c2d4-4d78-420f-b323-8133088c9472&clientId=717661f0-ab27-4d5c-b1a7-f5cbbe757146&contextId=contentId-892567553&collection=contentId-892567553",
