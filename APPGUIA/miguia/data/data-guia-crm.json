          "url": "blob:https://aquaservice.atlassian.net/92cfceca-fada-4a8a-b81c-f869fe65ab6e#media-blob-url=true&id=81b7191a-eabc-496b-9e16-2f84b3970603&clientId=717661f0-ab27-4d5c-b1a7-f5cbbe757146&contextId=contentId-892567553&collection=contentId-892567553",
          "nombre": "image-20250317-184956.png"
