  {
    "ID": 5,
    "tema": "Excluir de la campaña Cobros KA",
    "descripcion": [
      {
        "tipo": "texto",
        "valor": "Abrimos CRM, Configuración, Valores variables. Ponemos el código LSTUSRKA y añadimos las iniciales con una coma detrás.",
        "img": {
          "url": "blob:https://aquaservice.atlassian.net/92cfceca-fada-4a8a-b81c-f869fe65ab6e#media-blob-url=true&id=b3c7356b-eae3-4ec5-862a-694d8353b196&clientId=717661f0-ab27-4d5c-b1a7-f5cbbe757146&contextId=contentId-8390378&collection=contentId-8390378",
