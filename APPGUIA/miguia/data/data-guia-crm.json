      },
      {
        "tipo": "texto",
        "valor": "Con esta información vamos al historial de entregas en la ficha del cliente y entramos en Albaranes pendientes.",
        "img": {
          "url": "blob:https://aquaservice.atlassian.net/92cfceca-fada-4a8a-b81c-f869fe65ab6e#media-blob-url=true&id=475424d3-4485-4e28-82c9-249b2e70685d&clientId=717661f0-ab27-4d5c-b1a7-f5cbbe757146&contextId=contentId-8390976&collection=contentId-8390976",
          "nombre": "image2021-8-17_11-7-24.png"
