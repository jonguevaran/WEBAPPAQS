      },
      {
        "tipo": "texto",
        "valor": "Verificamos que la promoción ha sido recuperada correctamente.",
        "img": {
          "url": "blob:https://aquaservice.atlassian.net/92cfceca-fada-4a8a-b81c-f869fe65ab6e#media-blob-url=true&id=9d03b21d-2722-4054-8827-be7c80784567&clientId=717661f0-ab27-4d5c-b1a7-f5cbbe757146&contextId=contentId-892567553&collection=contentId-892567553",
          "nombre": "image-20250317-185150.png"
        }
      }
    ],
    "tags": ["CRM", "promociones", "permisos", "operaciones"]
