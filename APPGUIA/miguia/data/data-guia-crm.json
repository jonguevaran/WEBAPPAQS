  {
    "ID": 2,
    "tema": "Albarán sin fecha de confirmación",
    "descripcion": [
      {
        "tipo": "texto",
        "valor": "Al importar albaranes puede salirnos un aviso de albarán sin fecha de confirmación.",
        "img": {
          "url": "blob:https://aquaservice.atlassian.net/92cfceca-fada-4a8a-b81c-f869fe65ab6e#media-blob-url=true&id=bdc3a95b-20b0-45cd-85bf-8a86167e361a&clientId=717661f0-ab27-4d5c-b1a7-f5cbbe757146&contextId=contentId-8390976&collection=contentId-8390976",
          "nombre": "image2021-8-17_11-0-58.png"
        }
      },
      {
        "tipo": "texto",
        "valor": "Entrar a caché, a los Globals, al SWALB(ALMACEN,NºDocumento, y comprobar qué cliente es.",
        "img": {
          "url": "blob:https://aquaservice.atlassian.net/92cfceca-fada-4a8a-b81c-f869fe65ab6e#media-blob-url=true&id=9550e7c8-85f0-4513-93f7-daa97482067e&clientId=717661f0-ab27-4d5c-b1a7-f5cbbe757146&contextId=contentId-8390976&collection=contentId-8390976",
