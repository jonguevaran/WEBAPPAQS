        }
      },
      {
        "tipo": "texto",
        "valor": "Pulsamos el botón de eliminar y confirmamos la acción.",
        "img": {
          "url": "blob:https://aquaservice.atlassian.net/92cfceca-fada-4a8a-b81c-f869fe65ab6e#media-blob-url=true&id=4aaa094b-7ccd-4c69-b0d6-bca27d00b4bd&clientId=717661f0-ab27-4d5c-b1a7-f5cbbe757146&contextId=contentId-892567553&collection=contentId-892567553",
          "nombre": "image-20250317-185106.png"
        }
      },
      {
        "tipo": "texto",
        "valor": "Para recuperar una promoción eliminada, editamos el global ^PROMOCIONCLIENTEBORR y lo renombramos a ^PROMOCIONCLIENTE.",
        "img": {
          "url": "blob:https://aquaservice.atlassian.net/92cfceca-fada-4a8a-b81c-f869fe65ab6e#media-blob-url=true&id=f749e308-c261-4d18-bab2-7c6350b6164b&clientId=717661f0-ab27-4d5c-b1a7-f5cbbe757146&contextId=contentId-892567553&collection=contentId-892567553",
